# Copy this file to .env and fill in your own values. Never commit .env.

# Token from @BotFather (looks like 123456789:AA...). The placeholder below is NOT a real token.
BOT_TOKEN=123456789:replace-with-your-token-from-BotFather

# Public HTTPS address of this server, without a trailing slash (for example a free cloudflared tunnel).
# The Mini App opens at https://<address>/webapp/ and anyone checks a certificate at https://<address>/webapp/?v=<code>.
# Leave empty to run the bot only (certificates are then checked in the bot: t.me/<bot>?start=v_<code>).
PUBLIC_URL=

# Telegram user ids of admins (comma separated): counts and blocking a club. Find yours with @userinfobot.
ADMIN_IDS=

# Key that signs certificate codes. Any long random text; if empty, one is derived from BOT_TOKEN.
# Changing it makes every certificate issued so far fail the check.
CERT_SECRET=

# Pages a reader can log for one day (a bigger claim is trimmed and flagged for the club leader).
DAILY_CAP=300

# Where the SQLite file lives (the folder is created automatically).
DB_PATH=data/kitobklubi.db
# Fill an empty database with the fictional world (a club, five readers, a running marathon). 0 = start empty.
# Seeded people have negative ids, so nobody can sign in as them.
SEED_DEMO=1

# Web server for the Mini App and its API.
HOST=0.0.0.0
PORT=8080

# Mini App login data older than this many seconds is refused.
INITDATA_MAX_AGE=3600
# Bot buttons per user per minute, Mini App calls per user per minute, certificate checks per address per minute.
RATE_PER_MINUTE=30
API_RATE_PER_MINUTE=120
VERIFY_RATE_PER_MINUTE=30
# Set to 1 only behind a reverse proxy you control (then X-Forwarded-For is trusted for the check's rate limit).
TRUST_PROXY=0
LOG_LEVEL=INFO
